+def _sample_pay_and_certifications(
+    rng: random.Random, specialties: dict[str, int]
+) -> tuple[float, dict[str, float]]:
+    """Sample a worker's pay expectation and per-specialty certifications.
+
+    The certification draw is a single uniform per category so the values are
+    distributed as P(0.8)=0.3, P(0.5)=0.4, P(0.0)=0.3.
+    """
+    first_specialty = next(iter(specialties), None)
+    if first_specialty is None:
+        expected_pay = rng.uniform(2000, 12000)
+    else:
+        budget_min, budget_max = TASK_PROFILES[first_specialty]["budget"]
+        median_budget = (budget_min + budget_max) / 2
+        expected_pay = round(median_budget * rng.uniform(0.7, 1.3), 2)
+    certifications: dict[str, float] = {}
+    for category in specialties:
+        r = rng.random()
+        certifications[category] = (
+            0.8 if r < 0.3 else 0.5 if r < 0.7 else 0.0
+        )
+    return expected_pay, certifications
+
