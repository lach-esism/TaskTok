[Unit]
Description=TaskTok persistent HTTPS tunnel
After=network-online.target evomatch-baseline.service
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
Environment=HOME=/home/agent
ExecStart=/usr/bin/ssh -T -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/home/agent/.ssh/known_hosts -R 80:127.0.0.1:4173 nokey@localhost.run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
