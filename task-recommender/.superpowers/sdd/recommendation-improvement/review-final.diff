+# Dataset container.
+# ---------------------------------------------------------------------------
+@dataclass
+class LargeDataset:
+    workers: list[dict]
+    tasks: list[dict]
+    customers: list[dict]
+    assignments: list[dict]
+    splits: dict[str, str]
+    metadata: dict
+    stats: dict = field(default_factory=dict)
+    labels: dict[str, dict] = field(default_factory=dict, repr=False)
+
