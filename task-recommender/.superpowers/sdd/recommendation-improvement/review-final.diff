+
+
+_SKILL_NORMALIZER: dict[str, str] | None = None
+_CATEGORY_NORMALIZER: dict[str, str] | None = None
+
+
+def _skill_normalizer() -> dict[str, str]:
+    global _SKILL_NORMALIZER
+    if _SKILL_NORMALIZER is None:
+        mapping = _unambiguous_phrase_map(SKILL_KEYWORDS)
+        # Canonical keys map to themselves so ``normalize_skill("backend")``
+        # round-trips.
+        for key in SKILL_KEYWORDS:
+            mapping[_normalized_key(key)] = key
+        for alias_key, key in _load_alias_map().items():
+            if alias_key.startswith("skill:"):
+                mapping[alias_key[len("skill:"):]] = key
+        _SKILL_NORMALIZER = mapping
+    return _SKILL_NORMALIZER
+
+
+def _category_normalizer() -> dict[str, str]:
+    global _CATEGORY_NORMALIZER
+    if _CATEGORY_NORMALIZER is None:
+        mapping = _unambiguous_phrase_map(CATEGORY_KEYWORDS)
+        for key, label in CATEGORY_LABELS.items():
+            mapping[_normalized_key(label)] = key
+            mapping[_normalized_key(key)] = key
+        for alias_key, key in _load_alias_map().items():
+            if alias_key.startswith("category:"):
+                mapping[alias_key[len("category:"):]] = key
+        _CATEGORY_NORMALIZER = mapping
+    return _CATEGORY_NORMALIZER
+
+
+def normalize_skill(token: str) -> str | None:
+    """Map a free-text skill token to its taxonomy key, or ``None``.
+
+    Accepts canonical keys (``backend``), Chinese labels (``后端开发`` via
+    aliases), and unambiguous keyword phrases (``后端`` -> ``backend``).
+    """
+    key = _normalized_key(token)
+    if not key:
+        return None
+    return _skill_normalizer().get(key)
+
+
+def normalize_category(token: str) -> str | None:
+    """Map a free-text category token to its taxonomy key, or ``None``.
+
+    Accepts canonical keys, Chinese labels (``软件开发``), and unambiguous
+    keyword phrases (``招聘`` -> ``recruitment``).
+    """
+    key = _normalized_key(token)
+    if not key:
+        return None
+    return _category_normalizer().get(key)
+
+
+def known_skills() -> frozenset[str]:
+    """The canonical skill taxonomy keys."""
+    return frozenset(SKILL_KEYWORDS)
+
+
+def known_categories() -> frozenset[str]:
+    """The canonical category taxonomy keys."""
+    return frozenset(CATEGORY_KEYWORDS)

