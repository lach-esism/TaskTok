+                ("scheme", dataset.metadata.get("scheme", "E")),
+                ("seed", str(dataset.metadata.get("seed"))),
+            ]
+        )
+    )
+
+    lines.append("\n## Duplicate checks (computed from the emitted corpus)\n")
+    lines.append(
+        _table(
