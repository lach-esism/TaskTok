+def _resume_skill_labels(skills: dict[str, int], category: str, profile: dict) -> list[str]:
+    # Use the worker's full skill set (not just category-relevant skills) so two
+    # workers in the same category still diverge substantially in text.
+    ranked = sorted(skills.items(), key=lambda item: (-item[1], item[0]))
+    labels: list[str] = []
+    for skill, _ in ranked:
+        label = SKILL_LABELS.get(skill)
+        if label and label not in labels:
+            labels.append(label)
+        if len(labels) >= 8:
+            break
+    for tag in profile["tags"]:
+        if tag not in labels:
+            labels.append(tag)
+        if len(labels) >= 8:
+            break
+    return labels[:8]
+
