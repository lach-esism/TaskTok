[Unit]
Description=TaskTok hackathon demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/evomatch
ExecStart=/usr/local/bin/node %h/repos/evomatch/scripts/serve.mjs
Environment=HOST=0.0.0.0
Environment=PORT=4173
Environment=NODE_ENV=production
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
