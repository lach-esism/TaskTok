+        # namespace only disambiguates consumers, so encode it in the key.
+        result[f"{namespace}:{key}"] = key
+        for alias in alias_text.replace("，", ",").split(","):
+            alias = _normalized_key(alias)
+            if alias:
+                result[f"{namespace}:{alias}"] = key
