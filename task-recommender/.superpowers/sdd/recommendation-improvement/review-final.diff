+    lines.append("\n## Duration (days)\n")
+    duration = stats["duration_days"]
+    lines.append(
+        _table(
+            [
+                ("min", str(duration["min"])),
+                ("mean", f"{duration['mean']:.1f}"),
+                ("max", str(duration["max"])),
+            ]
+        )
