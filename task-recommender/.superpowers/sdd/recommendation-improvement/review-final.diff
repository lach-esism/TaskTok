+                ("workers", str(stats["n_workers"])),
+                ("tasks", str(stats["n_tasks"])),
+                ("customers", str(stats["n_customers"])),
+                ("assignments", str(stats["n_assignments"])),
+                ("train tasks", str(stats["train_tasks"])),
+                ("test tasks", str(stats["test_tasks"])),
