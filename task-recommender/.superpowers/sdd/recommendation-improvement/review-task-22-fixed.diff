+from __future__ import annotations
+
+import asyncio
+import io
+import json
+import zipfile
+from datetime import datetime, timezone
+from types import SimpleNamespace
+
+import pytest
+
+from app.semantic import SemanticMatcher
+from app.upload import extract
+from app.upload.analyze import (
+    analyze_resume_text,
+    analyze_task_text,
+    build_task_draft,
+    task_from_analysis,
+    worker_from_draft,
+)
+from app.upload.extract import (
+    MAX_UPLOAD_BYTES,
+    UploadError,
+    extract_text,
+    sanitize_filename,
+)
+
+TASK_TEXT = (
+    "我们需要开发一个会员小程序，包含前端页面、接口联调和后台管理，"
+    "预算 8000-20000 元，30 天内交付，可以远程。"
+)
+
+RESUME_TEXT = """张三
+教育经历
+复旦大学 计算机科学与技术 本科
+工作经历
+2020 - 至今 云启科技 后端工程师
+负责接口开发与数据库设计
+技能
+Python、后端开发、数据库、接口、Figma
+期望薪资：15000 元/月
+上海 · 可远程
