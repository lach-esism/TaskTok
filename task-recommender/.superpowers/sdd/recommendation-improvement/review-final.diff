     "training_design": ("课程设计", "培训方案", "课程开发", "训练营"),
     "content_development": ("课件", "教材", "课程内容", "讲师手册"),
     "security": ("信息安全", "安全", "渗透测试"),
     "design": ("设计", "视觉", "审美"),
     "operations": ("运营", "日常运营", "活动运营"),
     "legal": ("法律", "合同", "合规", "版权"),
 }
+
+
+def _normalized_key(token: str) -> str:
+    return normalize_text(token).lower()
+
+
+def _unambiguous_phrase_map(
+    keyword_map: dict[str, dict[str, float] | tuple[str, ...]],
+) -> dict[str, str]:
+    """Map each *unambiguous* phrase to its key, skipping shared phrases."""
+    owners: dict[str, set[str]] = {}
+    for key, phrases in keyword_map.items():
+        for phrase in phrases:
+            owners.setdefault(_normalized_key(phrase), set()).add(key)
+    return {
+        phrase: next(iter(keys))
+        for phrase, keys in owners.items()
+        if len(keys) == 1
+    }
+
+
+def _load_alias_map() -> dict[str, str]:
+    """Load additive ``key<TAB>alias,alias`` entries from aliases.txt.
+
+    Lines are namespaced as ``skill<TAB><key><TAB>aliases`` or
+    ``category<TAB><key><TAB>aliases``; bare ``<key><TAB>aliases`` lines are
+    treated as skill aliases for convenience.
+    """
+    result: dict[str, str] = {}
+    path = LEXICON_DIR / "aliases.txt"
+    if not path.exists():
+        return result
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        parts = [part.strip() for part in line.split("\t")]
+        if len(parts) < 2:
+            continue
+        if parts[0] in {"skill", "category"}:
+            if len(parts) < 3:
+                continue
+            namespace, key, alias_text = parts[0], parts[1], parts[2]
+        else:
+            namespace, key, alias_text = "skill", parts[0], parts[1]
+        key = key.strip()
+        if not key:
+            continue
