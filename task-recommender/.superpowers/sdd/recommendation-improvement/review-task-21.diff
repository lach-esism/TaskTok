+# ---------------------------------------------------------------------------
+# Text hashing / near-duplicate detection (21c).
+# ---------------------------------------------------------------------------
+def _normalize_for_hash(text: str) -> str:
+    text = unicodedata.normalize("NFKC", text or "")
+    text = text.lower()
+    text = re.sub(r"\s+", " ", text)
+    return text.strip()
+
+
+def normalized_text_hash(text: str) -> str:
+    """Exact normalized SHA-256 hex digest of ``text``."""
+    return hashlib.sha256(_normalize_for_hash(text).encode("utf-8")).hexdigest()
+
+
+def _mix64(value: int) -> int:
+    """MurmurHash3 fmix64 finalizer for full 64-bit avalanche."""
+    mask = 0xFFFFFFFFFFFFFFFF
+    value ^= value >> 33
+    value = (value * 0xFF51AFD7ED558CCD) & mask
+    value ^= value >> 33
+    value = (value * 0xC4CEB9FE1A85EC53) & mask
+    value ^= value >> 33
+    return value
+
+
+def _token_hash64(token: str) -> int:
+    """Deterministic FNV-1a 64-bit hash with an fmix64 finalizer.
+
+    The finalizer is required because raw FNV-1a over very short byte strings
+    (single CJK characters, bigrams) leaves many output bits correlated, which
+    collapses the simhash Hamming distance. The finalizer restores full bit
+    avalanche while keeping the hash stable across runs and processes.
+    """
+    value = 14695981039346656037
+    for byte in token.encode("utf-8"):
+        value ^= byte
+        value = (value * 1099511628211) & 0xFFFFFFFFFFFFFFFF
+    return _mix64(value)
+
+
+def _simhash_tokens(text: str) -> list[str]:
+    chars = list(text or "")
+    if not chars:
+        return []
+    tokens = list(chars)
+    tokens.extend(chars[i] + chars[i + 1] for i in range(len(chars) - 1))
+    return tokens
+
+
+def simhash64(text: str) -> int:
+    """64-bit simhash over character unigrams + bigrams.
+
+    Shared tokens vote identically, so near-duplicate texts (a handful of
+    differing characters) land within a small Hamming distance while genuinely
+    distinct texts separate toward ~32 bits.
+    """
+    tokens = _simhash_tokens(text)
+    if not tokens:
+        return 0
+    hashes = np.asarray([_token_hash64(token) for token in tokens], dtype=np.uint64)
+    count = hashes.size
+    result = 0
+    for bit in range(64):
+        ones = int(((hashes >> np.uint64(bit)) & np.uint64(1)).sum())
+        if ones > count - ones:
+            result |= 1 << bit
+    return result
+
+
+def is_near_duplicate(a: str, b: str, max_hamming: int = 3) -> bool:
+    """True when the simhash Hamming distance is within ``max_hamming``."""
+    return (simhash64(a) ^ simhash64(b)).bit_count() <= max_hamming
+
+
+class _DedupIndex:
+    """Exact-hash + unique-title + 4-block simhash near-duplicate index.
+
+    Two 64-bit simhashes with Hamming distance <= 3 must share at least one of
+    four 16-bit blocks (pigeonhole), so candidate lookup is O(1) per block.
+    """
+
+    def __init__(self) -> None:
+        self._hashes: set[str] = set()
+        self._titles: set[str] = set()
+        self._blocks: list[dict[int, list[tuple[str, int]]]] = [
+            defaultdict(list) for _ in range(4)
+        ]
+        self._simhashes: dict[str, int] = {}
+        self.near_dup_rejections = 0
+
+    def contains(
+        self, text: str, title: str | None = None, fingerprint: int | None = None
+    ) -> bool:
+        text_hash = normalized_text_hash(text)
+        if text_hash in self._hashes:
+            return True
+        if title is not None:
+            normalized_title = _normalize_for_hash(title)
+            if normalized_title in self._titles:
+                return True
+        if fingerprint is None:
+            fingerprint = simhash64(text)
+        for block in range(4):
+            block_value = (fingerprint >> (block * 16)) & 0xFFFF
+            for _, candidate_fingerprint in self._blocks[block][block_value]:
+                if (fingerprint ^ candidate_fingerprint).bit_count() <= 3:
+                    return True
+        return False
+
+    def add(self, text: str, title: str | None = None) -> bool:
+        fingerprint = simhash64(text)
+        if self.contains(text, title, fingerprint=fingerprint):
+            self.near_dup_rejections += 1
+            return False
+        text_hash = normalized_text_hash(text)
+        self._hashes.add(text_hash)
+        if title is not None:
+            self._titles.add(_normalize_for_hash(title))
+        for block in range(4):
+            block_value = (fingerprint >> (block * 16)) & 0xFFFF
+            self._blocks[block][block_value].append((text_hash, fingerprint))
+        self._simhashes[text_hash] = fingerprint
+        return True
+
