+        "工作经历：" + "；".join(experience_lines),
+        "项目经历：" + "；".join(project_lines),
+        cert_line,
+        f"{availability}，期望报酬 {expected_rate}",
+    ]
+    resume_text = "。".join(part.rstrip("。") for part in parts) + "。"
+
+    resume = {
+        "worker_id": meta["worker_id"],
+        "name": name,
+        "city": city,
+        "title": profile["headline"],
+        "skills": skills,
+        "projects": [project[0] for project in chosen_projects],
+        "certifications": certifications,
+        "experience_years": years,
+        "resume_text": resume_text,
+    }
+    return resume, resume_text
+
+
+# ---------------------------------------------------------------------------
+# Dataset container.
+# ---------------------------------------------------------------------------
+@dataclass
+class LargeDataset:
+    workers: list[dict]
+    tasks: list[dict]
+    customers: list[dict]
+    assignments: list[dict]
+    splits: dict[str, str]
+    metadata: dict
+    stats: dict = field(default_factory=dict)
+    labels: dict[str, dict] = field(default_factory=dict, repr=False)
+
+
+# ---------------------------------------------------------------------------
+# Main generator.
+# ---------------------------------------------------------------------------
+def _apply_llm_seed_texts(
+    llm_seeds: dict | None,
+    n_tasks: int,
+    n_workers: int,
+) -> tuple[dict[int, dict], dict[int, dict]]:
+    """Normalize the optional scheme-C hook into per-index overrides.
+
+    Returns ``(task_overrides, resume_overrides)`` keyed by record index. Only a
+    small deterministic subset of records is affected and every seed still has
+    to pass the dedup index at insert time.
+    """
+    if not llm_seeds:
+        return {}, {}
+    task_overrides: dict[int, dict] = {}
+    resume_overrides: dict[int, dict] = {}
+    for position, entry in enumerate(llm_seeds.get("tasks", [])[: max(1, n_tasks // 20)]):
+        index = (position * 20) % n_tasks
+        task_overrides[index] = {
+            "title": str(entry.get("title") or entry.get("task_text", "")[:30]),
+            "task_text": str(entry.get("task_text") or ""),
+        }
+    for position, entry in enumerate(llm_seeds.get("resumes", [])[: max(1, n_workers // 20)]):
+        index = (position * 20) % n_workers
+        resume_overrides[index] = {
+            "resume_text": str(entry.get("resume_text") or ""),
+        }
+    return task_overrides, resume_overrides
+
+
+def _quota_plan(rng: random.Random, items: list[str], total: int) -> list[str]:
+    """Deterministic quota assignment summing to ``total``."""
+    base, remainder = divmod(total, len(items))
+    plan = []
+    for item in items:
+        plan.extend([item] * base)
+    plan.extend(items[:remainder])
+    rng.shuffle(plan)
+    return plan
+
+
+def _sample_skills(rng: random.Random, categories: list[str]) -> dict[str, int]:
+    pool = set()
+    for category in categories:
+        pool.update(CATEGORY_SKILLS.get(category, set()))
+    if not pool:
+        pool = set(SKILLS)
+    chosen = rng.sample(sorted(pool), k=min(len(pool), rng.randint(10, 16)))
+    return {skill: rng.randint(1, 5) for skill in chosen}
+
+
+def generate_large_dataset(
+    n_workers: int = 1000,
+    n_tasks: int = 10000,
+    n_assignments: int = 100000,
+    seed: int = 42,
+    llm_seeds: dict | None = None,
+) -> LargeDataset:
+    """Generate the reproducible large natural-language benchmark."""
+    rng = random.Random(seed)
+    np_rng = np.random.default_rng(seed)
+
+    task_overrides, resume_overrides = _apply_llm_seed_texts(
+        llm_seeds, n_tasks, n_workers
+    )
+
+    # ---- Workers (latent traits) -------------------------------------------
+    worker_metas: list[dict] = []
+    used_names: set[str] = set()
+    for i in range(n_workers):
+        worker_id = f"w{i + 1:04d}"
+        specialties = rng.sample(CATEGORIES, k=rng.randint(1, 3))
+        specialty_levels = {
+            category: rng.randint(1, 5) for category in specialties
+        }
+        skills = _sample_skills(rng, specialties)
+        low_difficulty = rng.randint(1, 4)
+        high_difficulty = rng.randint(low_difficulty + 1, 5)
+        meta = {
+            "worker_id": worker_id,
+            "name": _unique_name(rng, used_names),
+            "skills": skills,
+            "specialties": specialty_levels,
+            "level": rng.randint(1, 5),
+            "capacity_hours": float(rng.randint(30, 50)),
+            "current_load_hours": float(rng.randint(0, 15)),
+            "preferred_categories": {
+                category: round(rng.uniform(0.3, 0.9), 2)
+                for category in specialties
+            },
+            "preferred_difficulty": (low_difficulty, high_difficulty),
+            "region": rng.choice(REGIONS),
+            "remote_ok": rng.random() < 0.6,
+            "reliability": rng.uniform(0.4, 1.0),
+            "expected_pay": 0.0,
+        }
+        top_category = max(
+            specialty_levels, key=lambda key: (specialty_levels[key], key)
+        ) if specialty_levels else "consulting_research"
+        meta["top_category"] = top_category
+        budget_min, budget_max = TASK_PROFILES.get(
+            top_category, TASK_PROFILES["consulting_research"]
+        )["budget"]
+        meta["expected_pay"] = round(
+            (budget_min + budget_max) / 2 * rng.uniform(0.7, 1.3), 2
+        )
+        worker_metas.append(meta)
+
+    # ---- Customers ----------------------------------------------------------
+    n_customers = max(10, n_workers // 2)
+    customers: list[dict] = []
+    customer_leniency: dict[str, float] = {}
+    customer_region: dict[str, str] = {}
+    for i in range(n_customers):
+        customer_id = f"c{i + 1:04d}"
+        preferred = rng.sample(CATEGORIES, k=2)
+        customers.append(
+            {
+                "customer_id": customer_id,
+                "name": f"客户{i + 1:04d}",
+                "region": rng.choice(REGIONS),
+                "preferred_categories": {
+                    category: round(rng.uniform(0.6, 0.95), 3)
+                    for category in preferred
+                },
+            }
+        )
+        customer_leniency[customer_id] = rng.uniform(-0.25, 0.25)
+        customer_region[customer_id] = customers[-1]["region"]
+
+    # ---- Quotas and task latent ---------------------------------------------
+    category_plan = _quota_plan(rng, CATEGORIES, n_tasks)
+    industry_plan = _quota_plan(rng, INDUSTRY_NAMES, n_tasks)
+
+    task_metas: list[dict] = []
+    task_texts: list[str] = []
+    task_titles: list[str] = []
+    task_index = _DedupIndex()
+
+    for j in range(n_tasks):
+        category = category_plan[j]
+        industry = industry_plan[j]
+        profile = TASK_PROFILES[category]
+        task_rng = random.Random(f"{seed}|task|{j}|latent")
+
+        subject = task_rng.choice(INDUSTRIES[industry]["subjects"])
+        required_skills = task_rng.sample(
+            sorted(CATEGORY_SKILLS.get(category, set())),
+            k=min(2, len(CATEGORY_SKILLS.get(category, set()))),
+        )
+        required_skill_levels = {
+            skill: task_rng.randint(1, 3) for skill in required_skills
+        }
+        required_level = task_rng.randint(1, 2)
+        difficulty = task_rng.randint(1, 5)
+        urgency = task_rng.randint(1, 5)
+        estimated_hours = round(task_rng.uniform(2, 24), 1)
+        customer_id = rng.choice(customers)["customer_id"]
+        region = customer_region[customer_id]
+        remote_ok = rng.random() < 0.5
+        base_min, base_max = profile["budget"]
+        scale = task_rng.uniform(0.85, 1.2)
+        budget_min = float(round(base_min * scale / 100) * 100)
+        budget_max = float(round(base_max * scale / 100) * 100)
+        days = task_rng.randint(*profile["days"])
+        created_at = BASE_TIME + timedelta(
+            days=(j * 37) % 360, hours=(j * 13) % 24
+        )
+        deadline = created_at + timedelta(days=days)
+
+        # ---- Render natural-language text with retry-on-duplicate ------------
+        title = ""
+        task_text = ""
+        override = task_overrides.get(j)
+        if override and override.get("task_text"):
+            title = override["title"]
+            task_text = override["task_text"]
+            if not task_index.add(task_text, title):
+                title, task_text = "", ""
+        if not task_text:
+            for attempt in range(200):
+                text_rng = random.Random(f"{seed}|task|{j}|text|{attempt}")
+                object_phrase = text_rng.choice(CATEGORY_OBJECTS[category])
+                qualifier = text_rng.choice(TITLE_QUALIFIERS)
+                subject = text_rng.choice(INDUSTRIES[industry]["subjects"])
+                title = subject + object_phrase + qualifier
+                industry_context = text_rng.choice(
+                    INDUSTRIES[industry]["contexts"]
+                )
+                background = text_rng.choice(BACKGROUND_PATTERNS).format(
+                    subject=subject,
+                    object=object_phrase,
+                    industry_context=industry_context.rstrip("。"),
+                )
+
+                requirements = text_rng.sample(
+                    CATEGORY_REQUIREMENTS[category],
+                    k=text_rng.randint(3, min(4, len(CATEGORY_REQUIREMENTS[category]))),
+                )
+                skill_phrase = "、".join(
+                    SKILL_LABELS.get(skill, skill)
+                    for skill in sorted(required_skill_levels)
+                )
+                if skill_phrase:
+                    requirements.append(
+                        text_rng.choice(SKILL_LEADS).format(skills=skill_phrase)
+                    )
+
+                deliverables = list(profile["deliverables"])
+                text_rng.shuffle(deliverables)
+                deliverables_sentence = text_rng.choice(
+                    DELIVERABLE_PATTERNS
+                ).format(items="、".join(deliverables))
+
+                mode = (
+                    MODE_REMOTE
+                    if remote_ok
+                    else MODE_ONSITE.format(
+                        region=REGION_LABELS.get(region, region)
+                    )
+                )
+                constraint = text_rng.choice(CONSTRAINT_PATTERNS).format(
+                    budget_min=f"{budget_min:,.0f}",
+                    budget_max=f"{budget_max:,.0f}",
+                    days=days,
+                )
+
+                lead = text_rng.choice(REQUIREMENT_LEADS)
+                requirement_text = "；".join(requirements)
+
+                def _clean_end(part: str) -> str:
+                    return part.rstrip("。")
+
+                task_text = "。".join(
+                    _clean_end(part)
+                    for part in [
+                        title,
+                        background,
+                        f"{lead}{requirement_text}",
+                        deliverables_sentence,
+                        f"{constraint}，{mode}",
+                    ]
+                ) + "。"
+                if task_index.add(task_text, title):
+                    break
+            else:
+                raise RuntimeError(f"could not generate unique task text for {j}")
+
+        task_metas.append(
+            {
+                "task_id": f"t{j + 1:05d}",
+                "customer_id": customer_id,
+                "category": category,
+                "industry": industry,
+                "required_skills": required_skill_levels,
+                "required_level": required_level,
+                "difficulty": difficulty,
+                "urgency": urgency,
+                "estimated_hours": estimated_hours,
+                "budget_min": budget_min,
+                "budget_max": budget_max,
+                "days": days,
+                "region": region,
+                "remote_ok": remote_ok,
+                "created_at": created_at,
+                "deadline": deadline,
+            }
+        )
+        task_texts.append(task_text)
+        task_titles.append(title)
+
+    # ---- Numpy latent arrays for the DGP ------------------------------------
+    n_skill = len(SKILLS)
+    w_skill = np.zeros((n_workers, n_skill), dtype=np.float32)
+    w_spec = np.zeros((n_workers, len(CATEGORIES)), dtype=np.float32)
+    w_pref = np.zeros((n_workers, len(CATEGORIES)), dtype=np.float32)
+    w_rel = np.zeros(n_workers, dtype=np.float32)
+    w_level = np.zeros(n_workers, dtype=np.int32)
+    w_capacity = np.zeros(n_workers, dtype=np.float32)
+    w_load = np.zeros(n_workers, dtype=np.float32)
+    w_region = [""] * n_workers
+    w_remote = [False] * n_workers
+    w_pay = np.zeros(n_workers, dtype=np.float32)
+    for i, meta in enumerate(worker_metas):
+        for skill, level in meta["skills"].items():
+            w_skill[i, SKILL_INDEX[skill]] = float(level)
+        for category, level in meta["specialties"].items():
+            w_spec[i, CATEGORY_INDEX[category]] = float(level)
+        for category, value in meta["preferred_categories"].items():
+            w_pref[i, CATEGORY_INDEX[category]] = value
+        w_rel[i] = meta["reliability"]
+        w_level[i] = meta["level"]
+        w_capacity[i] = meta["capacity_hours"]
+        w_load[i] = meta["current_load_hours"]
+        w_region[i] = meta["region"]
+        w_remote[i] = meta["remote_ok"]
+        w_pay[i] = meta["expected_pay"]
+
+    # ---- Split (task-level, deterministic 80/20) -----------------------------
+    split_rng = random.Random(seed + 11)
+    order = list(range(n_tasks))
+    split_rng.shuffle(order)
+    test_count = n_tasks // 5
+    test_indices = set(order[:test_count])
+    splits: dict[str, str] = {}
+    for j in range(n_tasks):
+        splits[f"t{j + 1:05d}"] = "test" if j in test_indices else "train"
+
+    # ---- Assignments DGP (B) -------------------------------------------------
+    base_pool = n_assignments // n_tasks
+    remainder = n_assignments % n_tasks
+    assignments: list[dict] = []
+    gold_labels: dict[str, dict] = {}
+    assignment_counter = 0
+
+    for j in range(n_tasks):
+        meta = task_metas[j]
+        task_id = meta["task_id"]
+        category_idx = CATEGORY_INDEX[meta["category"]]
+        required_skills = meta["required_skills"]
+        if required_skills:
+            skill_match = np.zeros(n_workers, dtype=np.float32)
+            for skill, minimum in required_skills.items():
+                column = w_skill[:, SKILL_INDEX[skill]]
+                skill_match += np.minimum(column / float(minimum), 1.0)
+            skill_match /= len(required_skills)
+        else:
+            skill_match = np.full(n_workers, 0.4, dtype=np.float32)
+
+        specialty = w_spec[:, category_idx] / 5.0
+        load_ratio = np.clip(
+            (w_load + meta["estimated_hours"]) / np.maximum(w_capacity, 1.0),
+            0.0,
+            1.0,
+        )
+        logging_weight = (
+            0.4 * skill_match
+            + 0.3 * specialty
+            + 0.2 * (1.0 - load_ratio)
+            + 0.1 * w_rel
+            + 0.001
+        )
+        probabilities = logging_weight / logging_weight.sum()
+        pool_size = base_pool + (1 if j < remainder else 0)
+        pool = np_rng.choice(
+            n_workers, size=pool_size, replace=False, p=probabilities
+        )
+
+        region_match = np.zeros(n_workers, dtype=np.float32)
+        for i in range(n_workers):
+            if w_region[i] == meta["region"] or meta["remote_ok"] or w_remote[i]:
+                region_match[i] = 1.0
+            else:
+                region_match[i] = 0.5
+
+        accept_flags: list[bool] = []
+        true_match = np.zeros(pool_size, dtype=np.float32)
+        for k, worker_index in enumerate(pool):
+            preference = float(w_pref[worker_index, category_idx])
+            pay_fit = 1.0 if float(w_pay[worker_index]) <= meta["budget_max"] * 1.2 else 0.4
+            accept_prob = _clamp(
+                0.35
+                + 0.4 * preference
+                + 0.15 * (1.0 - float(load_ratio[worker_index]))
+                + 0.05 * pay_fit
+                + 0.05 * float(region_match[worker_index]),
+                0.05,
+                0.95,
+            )
+            accept_flags.append(rng.random() < accept_prob)
+            true_match[k] = (
+                0.4 * float(skill_match[worker_index])
+                + 0.3 * float(w_rel[worker_index])
+                + 0.2 * preference
+                + 0.1 * (1.0 - float(load_ratio[worker_index]))
+                + 0.05 * _gumbel(rng)
+            )
+
+        if not any(accept_flags):
+            forced = int(np.argmax(true_match))
+            accept_flags[forced] = True
+
+        gold_position = int(np.argmax(true_match))
+        gold_worker_id = worker_metas[int(pool[gold_position])]["worker_id"]
+        gold_labels[task_id] = {
+            "gold_worker_id": gold_worker_id,
+            "split": splits[task_id],
+        }
+
+        for k, worker_index in enumerate(pool):
+            accepted = accept_flags[k]
+            on_time: int | None = None
+            rating: float | None = None
+            rework: int | None = None
+            if accepted:
+                on_time_prob = _clamp(
+                    0.55
+                    + 0.35 * float(skill_match[worker_index])
+                    + 0.15 * float(w_rel[worker_index])
+                    - 0.25 * float(load_ratio[worker_index])
+                    - 0.04 * meta["urgency"],
+                    0.05,
+                    0.98,
+                )
+                on_time = 1 if rng.random() < on_time_prob else 0
+                quality = _clamp(
+                    0.5 * float(skill_match[worker_index])
+                    + 0.3 * float(w_rel[worker_index])
+                    + 0.2 * float(on_time)
+                    + rng.uniform(-0.1, 0.1),
+                    0.0,
+                    1.0,
+                )
+                rework = 1 if quality < 0.45 and rng.random() < 0.5 else 0
+                rating = float(
+                    int(
+                        round(
+                            _clamp(
+                                1.0
+                                + 4.0 * quality
+                                + customer_leniency[meta["customer_id"]]
+                                + rng.uniform(-0.3, 0.3),
+                                1.0,
+                                5.0,
+                            )
+                        )
+                    )
+                )
+
+            assignment_counter += 1
+            assignments.append(
+                {
+                    "assignment_id": f"a{assignment_counter:07d}",
+                    "task_id": task_id,
+                    "worker_id": worker_metas[int(worker_index)]["worker_id"],
+                    "customer_id": meta["customer_id"],
+                    "status": "accepted" if accepted else "rejected",
+                    "on_time": on_time,
+                    "rating": rating,
+                    "rework": rework,
+                    "created_at": (
+                        meta["created_at"] + timedelta(hours=k + 1)
+                    ).isoformat(),
+                    "split": splits[task_id],
+                }
+            )
+
+    assignments.sort(key=lambda row: (row["created_at"], row["assignment_id"]))
+
+    # ---- Train-only worker aggregates ----------------------------------------
+    task_category_by_id = {meta["task_id"]: meta["category"] for meta in task_metas}
+    aggregates = {
+        meta["worker_id"]: {
+            "ratings": [],
+            "completed": 0,
+            "on_time": 0,
+            "rework": 0,
+            "category_ratings": defaultdict(list),
+        }
+        for meta in worker_metas
+    }
+    for assignment in assignments:
+        if assignment["split"] != "train" or assignment["status"] != "accepted":
+            continue
+        aggregate = aggregates[assignment["worker_id"]]
+        aggregate["completed"] += 1
+        aggregate["on_time"] += assignment["on_time"] or 0
+        aggregate["rework"] += assignment["rework"] or 0
+        aggregate["ratings"].append(assignment["rating"])
+        category = task_category_by_id[assignment["task_id"]]
+        aggregate["category_ratings"][category].append(assignment["rating"])
+
+    # ---- Resumes (A) with retry-on-duplicate ---------------------------------
+    workers: list[dict] = []
+    resume_index = _DedupIndex()
+    for i, meta in enumerate(worker_metas):
+        resume_text = ""
+        resume: dict = {}
+        override = resume_overrides.get(i)
+        if override and override.get("resume_text"):
+            resume_text = override["resume_text"]
+            if resume_index.add(resume_text):
+                resume = {
+                    "worker_id": meta["worker_id"],
+                    "name": meta["name"],
+                    "resume_text": resume_text,
+                }
+            else:
+                resume_text = ""
+        if not resume_text:
+            for attempt in range(200):
+                resume_rng = random.Random(f"{seed}|resume|{i}|{attempt}")
+                resume, resume_text = _render_resume(
+                    meta, aggregates[meta["worker_id"]], resume_rng
+                )
+                if resume_index.add(resume_text):
+                    break
+            else:
+                raise RuntimeError(f"could not generate unique resume for {i}")
+
+        aggregate = aggregates[meta["worker_id"]]
+        workers.append(
+            {
+                "worker_id": meta["worker_id"],
+                "name": meta["name"],
+                "resume_text": resume_text,
+                "skills": dict(meta["skills"]),
+                "specialties": dict(meta["specialties"]),
+                "level": meta["level"],
+                "rating": (
+                    round(sum(aggregate["ratings"]) / len(aggregate["ratings"]), 3)
+                    if aggregate["ratings"]
+                    else 4.5
+                ),
+                "completed": aggregate["completed"],
+                "on_time_rate": (
+                    round(aggregate["on_time"] / aggregate["completed"], 4)
+                    if aggregate["completed"]
+                    else 0.9
+                ),
+                "rework_rate": (
+                    round(aggregate["rework"] / aggregate["completed"], 4)
+                    if aggregate["completed"]
+                    else 0.0
+                ),
+                "capacity_hours": float(meta["capacity_hours"]),
+                "current_load_hours": float(meta["current_load_hours"]),
+                "region": meta["region"],
+                "remote_ok": int(meta["remote_ok"]),
+                "preferred_categories": dict(meta["preferred_categories"]),
+            }
+        )
+
+    # ---- Model-safe task rows (no category/gold) ------------------------------
+    tasks: list[dict] = []
+    for j, meta in enumerate(task_metas):
+        tasks.append(
+            {
+                "task_id": meta["task_id"],
+                "customer_id": meta["customer_id"],
+                "title": task_titles[j],
+                "task_text": task_texts[j],
+                "budget": round((meta["budget_min"] + meta["budget_max"]) / 2, 2),
+                "deadline": meta["deadline"].isoformat(),
+                "region": meta["region"],
+                "remote_ok": int(meta["remote_ok"]),
+                "split": splits[meta["task_id"]],
+            }
+        )
+
+    # ---- Stats ----------------------------------------------------------------
+    stats = _compute_stats(
+        n_workers,
+        n_tasks,
+        n_customers,
+        workers,
+        tasks,
+        task_metas,
+        assignments,
+        splits,
+        gold_labels,
+        task_index,
+        resume_index,
+    )
+
+    metadata = {
+        "seed": seed,
+        "n_workers": n_workers,
+        "n_tasks": n_tasks,
+        "n_assignments": n_assignments,
+        "scheme": "E",
+        "split": "80/20 task split",
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "llm_seeds": bool(llm_seeds),
+    }
+
+    return LargeDataset(
+        workers=workers,
+        tasks=tasks,
+        customers=customers,
+        assignments=assignments,
+        splits=splits,
+        metadata=metadata,
+        stats=stats,
+        labels=gold_labels,
+    )
+
+
+def _compute_stats(
+    n_workers: int,
+    n_tasks: int,
+    n_customers: int,
+    workers: list[dict],
+    tasks: list[dict],
+    task_metas: list[dict],
+    assignments: list[dict],
+    splits: dict[str, str],
+    gold_labels: dict[str, dict],
+    task_index: _DedupIndex,
+    resume_index: _DedupIndex,
+) -> dict:
+    train_tasks = sum(1 for split in splits.values() if split == "train")
+    test_tasks = sum(1 for split in splits.values() if split == "test")
+    accepted = sum(1 for row in assignments if row["status"] == "accepted")
+    rejected = len(assignments) - accepted
+
+    category_dist: dict[str, int] = defaultdict(int)
+    industry_dist: dict[str, int] = defaultdict(int)
+    budgets: list[float] = []
+    days: list[int] = []
+    for meta in task_metas:
+        category_dist[meta["category"]] += 1
+        industry_dist[meta["industry"]] += 1
+        budgets.append(round((meta["budget_min"] + meta["budget_max"]) / 2, 2))
+        days.append(meta["days"])
+
+    task_lengths = [len(task["task_text"]) for task in tasks]
+    resume_lengths = [len(worker["resume_text"]) for worker in workers]
+
+    rating_values = [
+        row["rating"] for row in assignments if row["rating"] is not None
+    ]
+    on_time_values = [
+        row["on_time"] for row in assignments if row["on_time"] is not None
+    ]
+
+    gold_workers = {label["gold_worker_id"] for label in gold_labels.values()}
+    gold_counts: dict[str, int] = defaultdict(int)
+    for label in gold_labels.values():
+        gold_counts[label["gold_worker_id"]] += 1
+
+    completeness_markers = {
+        "name": sum(1 for worker in workers if worker["name"]),
+        "city": sum(
+            1
+            for worker in workers
+            if any(city in worker["resume_text"] for city in _all_cities())
+        ),
+        "skills": sum(1 for worker in workers if "技能" in worker["resume_text"] or "擅长" in worker["resume_text"] or "熟练" in worker["resume_text"] or "核心能力" in worker["resume_text"]),
+        "projects": sum(1 for worker in workers if "项目" in worker["resume_text"]),
+        "certifications": sum(1 for worker in workers if "证书" in worker["resume_text"] or "认证" in worker["resume_text"]),
+        "experience": sum(1 for worker in workers if "担任" in worker["resume_text"] or "工作经历" in worker["resume_text"]),
+    }
+
+    return {
+        "n_workers": n_workers,
+        "n_tasks": n_tasks,
+        "n_customers": n_customers,
+        "n_assignments": len(assignments),
+        "train_tasks": train_tasks,
+        "test_tasks": test_tasks,
+        "accepted": accepted,
+        "rejected": rejected,
+        "task_exact_duplicates": 0,
+        "task_unique_titles": len({task["title"] for task in tasks}),
+        "task_near_dup_rate": 0.0,
+        "task_near_dup_rejections": task_index.near_dup_rejections,
+        "resume_exact_duplicates": 0,
+        "resume_near_dup_rate": 0.0,
+        "resume_near_dup_rejections": resume_index.near_dup_rejections,
+        "category_distribution": dict(sorted(category_dist.items())),
+        "industry_distribution": dict(sorted(industry_dist.items())),
+        "budget": {
+            "min": min(budgets),
+            "mean": round(sum(budgets) / len(budgets), 2),
+            "max": max(budgets),
+        },
+        "duration_days": {
+            "min": min(days),
+            "mean": round(sum(days) / len(days), 2),
+            "max": max(days),
+        },
+        "task_text_length": {
+            "min": min(task_lengths),
+            "mean": round(sum(task_lengths) / len(task_lengths), 1),
+            "max": max(task_lengths),
+        },
+        "resume_text_length": {
+            "min": min(resume_lengths),
+            "mean": round(sum(resume_lengths) / len(resume_lengths), 1),
+            "max": max(resume_lengths),
+        },
+        "resume_completeness": {
+            marker: round(count / n_workers, 4)
+            for marker, count in completeness_markers.items()
+        },
+        "rating_distribution": _histogram(rating_values, 1, 5),
+        "on_time_rate": (
+            round(sum(on_time_values) / len(on_time_values), 4)
+            if on_time_values
+            else 0.0
+        ),
+        "gold_workers": len(gold_workers),
+        "max_gold_share": (
+            round(max(gold_counts.values()) / len(gold_labels), 4)
+            if gold_labels
+            else 0.0
+        ),
+    }
+
+
+def _all_cities() -> list[str]:
+    return [city for cities in CITIES.values() for city in cities]
+
+
+def _histogram(values: list[float], low: int, high: int) -> dict[str, int]:
+    result = {str(value): 0 for value in range(low, high + 1)}
+    for value in values:
+        bucket = int(round(value))
+        result[str(min(high, max(low, bucket)))] += 1
+    return result

