 def fuse_scores(features: dict[str, float], weights: dict[str, float]) -> float:
     total_weight = sum(weights.values())
     if abs(total_weight - 1.0) > 1e-6:
         raise ValueError(f"weights must sum to 1.0, got {total_weight}")
