+def _table(rows: list[tuple[str, str]]) -> str:
+    lines = ["| item | value |", "| --- | --- |"]
+    lines.extend(f"| {key} | {value} |" for key, value in rows)
+    return "\n".join(lines)
+
+
+def write_stats_report(dataset, path: Path) -> Path:
