[Unit]
Description=TaskTok independent baseline public demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/repos/evomatch-baseline
ExecStart=/usr/local/bin/node /home/agent/repos/evomatch-baseline/scripts/serve.mjs
Environment=HOST=0.0.0.0
Environment=PORT=80
Environment=NODE_ENV=production
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
