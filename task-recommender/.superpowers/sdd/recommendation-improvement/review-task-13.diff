+            task,
+            skill=task_skill,
+            pay_fit=pay_fit,
+            region_match=self._region_match(worker, task),
+            historical_accept_rate=self._historical_accept_rate(
+                accept_counts, worker.worker_id
+            ),
+        )
+        return model.predict(features)
