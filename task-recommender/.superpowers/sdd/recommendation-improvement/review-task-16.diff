+class ListwiseChoiceLearner:
+    """Learn the seven fusion weights from a chosen candidate set.
+
+    Uses the softmax (listwise) gradient from
+    :meth:`app.benchmark.recommender.BenchmarkRecommender.learn`: the
+    target is a one-hot vector on ``chosen_index``, so each candidate
+    competes against every other candidate in the impression. Every
+    update is projected back onto the AHP simplex with
+    :func:`project_weights`.
+    """
+
+    def __init__(
+        self,
+        prior: dict[str, float],
+        l2: float = 0.1,
+        learning_rate: float = 0.05,
+    ) -> None:
+        self.prior = {key: float(value) for key, value in prior.items()}
+        self.keys = list(self.prior)
+        self.l2 = max(float(l2), 0.0)
+        self.learning_rate = float(learning_rate)
+        self.weights = project_weights(self.prior)
+
+    def learn(
+        self,
+        candidate_features: list[dict[str, float]],
+        chosen_index: int,
+        sample_weight: float = 1.0,
+    ) -> dict[str, float]:
+        """Apply one listwise gradient step over a candidate set."""
+        if not candidate_features:
+            return dict(self.weights)
+        if not 0 <= chosen_index < len(candidate_features):
+            raise IndexError("chosen_index out of range")
+
+        weights = dict(self.weights)
+        scores = [
+            sum(
+                weights[key] * float(features.get(key, 0.0))
+                for key in self.keys
+            )
+            for features in candidate_features
+        ]
+        maximum = max(scores)
+        exponentials = [
+            math.exp(score - maximum) for score in scores
+        ]
+        total = sum(exponentials)
+        probabilities = [value / total for value in exponentials]
+        scale = float(sample_weight)
+
+        for key in self.keys:
+            gradient = 0.0
+            for index, features in enumerate(candidate_features):
+                target = 1.0 if index == chosen_index else 0.0
+                gradient += (
+                    (probabilities[index] - target)
+                    * float(features.get(key, 0.0))
+                    * scale
+                )
+            weights[key] = (
+                weights[key]
+                - self.learning_rate * gradient
+                - self.l2 * (weights[key] - self.prior.get(key, 0.0))
+            )
+        self.weights = project_weights(weights)
+        return dict(self.weights)
+
