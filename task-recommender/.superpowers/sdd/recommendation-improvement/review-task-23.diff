     "content_development": ("课件", "教材", "课程内容", "讲师手册"),
     "security": ("信息安全", "安全", "渗透测试"),
     "design": ("设计", "视觉", "审美"),
     "operations": ("运营", "日常运营", "活动运营"),
     "legal": ("法律", "合同", "合规", "版权"),
 }
+
+
+def _normalized_key(token: str) -> str:
+    return normalize_text(token).lower()
+
+
+def _unambiguous_phrase_map(
+    keyword_map: dict[str, dict[str, float] | tuple[str, ...]],
+) -> dict[str, str]:
+    """Map each *unambiguous* phrase to its key, skipping shared phrases."""
+    owners: dict[str, set[str]] = {}
+    for key, phrases in keyword_map.items():
+        for phrase in phrases:
+            owners.setdefault(_normalized_key(phrase), set()).add(key)
+    return {
+        phrase: next(iter(keys))
+        for phrase, keys in owners.items()
+        if len(keys) == 1
+    }
+
+
+def _load_alias_map() -> dict[str, str]:
+    """Load additive ``key<TAB>alias,alias`` entries from aliases.txt.
+
+    Lines are namespaced as ``skill<TAB><key><TAB>aliases`` or
+    ``category<TAB><key><TAB>aliases``; bare ``<key><TAB>aliases`` lines are
+    treated as skill aliases for convenience.
+    """
+    result: dict[str, str] = {}
+    path = LEXICON_DIR / "aliases.txt"
+    if not path.exists():
+        return result
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        parts = [part.strip() for part in line.split("\t")]
+        if len(parts) < 2:
+            continue
+        if parts[0] in {"skill", "category"}:
+            if len(parts) < 3:
+                continue
+            namespace, key, alias_text = parts[0], parts[1], parts[2]
+        else:
+            namespace, key, alias_text = "skill", parts[0], parts[1]
+        key = key.strip()
+        if not key:
+            continue
+        # The alias file stores skill/category keys in the same flat map; the
+        # namespace only disambiguates consumers, so encode it in the key.
+        result[f"{namespace}:{key}"] = key
+        for alias in alias_text.replace("，", ",").split(","):
+            alias = _normalized_key(alias)
+            if alias:
+                result[f"{namespace}:{alias}"] = key
+    return result
+
+
+_SKILL_NORMALIZER: dict[str, str] | None = None
+_CATEGORY_NORMALIZER: dict[str, str] | None = None
+
+
+def _skill_normalizer() -> dict[str, str]:
+    global _SKILL_NORMALIZER
+    if _SKILL_NORMALIZER is None:
+        mapping = _unambiguous_phrase_map(SKILL_KEYWORDS)
+        # Canonical keys map to themselves so ``normalize_skill("backend")``
+        # round-trips.
+        for key in SKILL_KEYWORDS:
+            mapping[_normalized_key(key)] = key
+        for alias_key, key in _load_alias_map().items():
+            if alias_key.startswith("skill:"):
+                mapping[alias_key[len("skill:"):]] = key
+        _SKILL_NORMALIZER = mapping
+    return _SKILL_NORMALIZER
+
+
+def _category_normalizer() -> dict[str, str]:
+    global _CATEGORY_NORMALIZER
+    if _CATEGORY_NORMALIZER is None:
+        mapping = _unambiguous_phrase_map(CATEGORY_KEYWORDS)
+        for key, label in CATEGORY_LABELS.items():
+            mapping[_normalized_key(label)] = key
+            mapping[_normalized_key(key)] = key
+        for alias_key, key in _load_alias_map().items():
+            if alias_key.startswith("category:"):
+                mapping[alias_key[len("category:"):]] = key
+        _CATEGORY_NORMALIZER = mapping
+    return _CATEGORY_NORMALIZER
+
+
+def normalize_skill(token: str) -> str | None:
+    """Map a free-text skill token to its taxonomy key, or ``None``.
+
+    Accepts canonical keys (``backend``), Chinese labels (``后端开发`` via
+    aliases), and unambiguous keyword phrases (``后端`` -> ``backend``).
+    """
+    key = _normalized_key(token)
+    if not key:
+        return None
+    return _skill_normalizer().get(key)
+
+
+def normalize_category(token: str) -> str | None:
+    """Map a free-text category token to its taxonomy key, or ``None``.
+
+    Accepts canonical keys, Chinese labels (``软件开发``), and unambiguous
+    keyword phrases (``招聘`` -> ``recruitment``).
+    """
+    key = _normalized_key(token)
+    if not key:
+        return None
+    return _category_normalizer().get(key)
+
+
+def known_skills() -> frozenset[str]:
+    """The canonical skill taxonomy keys."""
+    return frozenset(SKILL_KEYWORDS)
+
+
+def known_categories() -> frozenset[str]:
+    """The canonical category taxonomy keys."""
+    return frozenset(CATEGORY_KEYWORDS)

