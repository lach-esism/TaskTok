[Unit]
Description=TaskTok independent baseline demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agent/repos/evomatch-baseline
ExecStart=/usr/local/bin/node /home/agent/repos/evomatch-baseline/scripts/serve.mjs
Environment=HOST=0.0.0.0
Environment=PORT=4173
Environment=NODE_ENV=production
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
