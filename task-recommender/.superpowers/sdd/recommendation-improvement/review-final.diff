+    weights["reputation"] = 0.9
+    projected, report = project_weights_with_report(weights)
+    assert projected["reputation"] <= 0.40 + 1e-9
+    assert report.reputation_hit_high == 1
+    assert abs(sum(projected.values()) - 1.0) < 1e-9
