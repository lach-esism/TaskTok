+def _unique_name(rng: random.Random, used: set[str]) -> str:
+    for _ in range(400):
+        name = (
+            rng.choice(SURNAMES)
+            + rng.choice(GIVEN_FIRST)
+            + rng.choice(GIVEN_SECOND)
+        )
+        if name not in used:
+            used.add(name)
+            return name
+    index = 0
+    while True:
+        name = (
+            rng.choice(SURNAMES)
+            + rng.choice(GIVEN_FIRST)
+            + rng.choice(GIVEN_SECOND)
+            + f"{index % 10}"
+        )
+        index += 1
+        if name not in used:
+            used.add(name)
+            return name
+
