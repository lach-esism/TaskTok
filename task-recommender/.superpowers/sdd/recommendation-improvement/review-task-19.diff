+    def features_for(
+        self, task_id: str, worker_id: str
+    ) -> dict[str, float]:
+        """Build the seven fusion features for one (task, worker) pair.
+
+        Uses the same feature construction as recommendation: the service's
+        ItemCF score, stored preference profiles, and a neutral semantic
+        similarity. ``KeyError`` is raised for unknown task or worker IDs so
+        callers can skip events that no longer resolve to store entities.
+        """
+        task = self.store.tasks.get(task_id)
+        if task is None:
+            raise KeyError(task_id)
+        worker = self.store.workers.get(worker_id)
+        if worker is None:
+            raise KeyError(worker_id)
+        customer = self.store.customers.get(task.customer_id)
+        if customer is None:
+            customer = Customer(
+                customer_id=task.customer_id,
+                name="Unknown",
+                region=task.region,
+            )
+        return candidate_features(
+            worker,
+            task,
+            customer,
+            cf_score=self.itemcf.score(worker_id, task_id),
+            now=self.reference_time,
+            worker_profile=self.store.worker_preferences.get(worker_id),
+            customer_profile=self.store.customer_preferences.get(
+                task.customer_id
+            ),
+            semantic_similarity=0.5,
+        )
+
