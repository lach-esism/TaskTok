 from __future__ import annotations
+
+from pathlib import Path
+
+from app.nlp.normalize import normalize_text
+
+LEXICON_DIR = Path(__file__).resolve().parent.parent.parent / "data" / "lexicon"
 
 CATEGORY_LABELS = {
